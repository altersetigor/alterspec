  "description": "alterspec - the spec changes with the product. Product spec framework for AI-assisted delivery.",
  "license": "MIT",
  "author": "Alterset d.o.o.",
  "homepage": "https://github.com/altersetigor/alterspec#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altersetigor/alterspec.git"
  },
