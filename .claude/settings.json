{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm ci)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx tsup:*)",
      "Bash(node:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npx @alterset/alterspec validate:*)",
      "Bash(npx prettier --check:*)",
      "Bash(npm view:*)",
      "Bash(npm pack --dry-run:*)",
      "Bash(git push origin main)"
    ],
    "ask": [
      "Bash(npm publish:*)",
      "Bash(npm login:*)",
      "Bash(npm adduser:*)",
      "Bash(npm config set:*)"
    ],
    "deny": [
      "Read(~/.npmrc)",
      "Edit(~/.npmrc)",
      "Write(~/.npmrc)"
    ]
  }
}
